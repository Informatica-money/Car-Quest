    <!-- HUD Overlay Layer -->
    <div class="relative z-10 flex flex-col justify-between h-screen w-screen p-4 md:p-6 pointer-events-none">
        
        <!-- Top Navigation Header -->
        <div class="flex justify-between items-start w-full">
